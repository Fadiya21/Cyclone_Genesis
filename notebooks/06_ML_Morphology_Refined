        "    \"pi_vmax_ms\", \"gpi\",\n",
        "]\n",
        "\n",
        "ID_COLS = [\n",
        "    \"track_id\", \"time\",\n",
        "    \"centroid_lon\", \"centroid_lat\",\n",
        "]\n",
        "\n",
        "print(\"CASE_DIR:\", CASE_DIR)\n",
