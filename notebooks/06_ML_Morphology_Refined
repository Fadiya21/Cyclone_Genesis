        "        ax.set_title(\n",
        "            f\"{dataset_name.upper()} feature ablation\\n\"\n",
        "            \"value = baseline F1 − ablated F1\"\n",
        "        )\n",
        "        ax.set_xticks(np.arange(len(pivot.columns)))\n",
        "        ax.set_xticklabels([f\"{c}h\" for c in pivot.columns])\n",
