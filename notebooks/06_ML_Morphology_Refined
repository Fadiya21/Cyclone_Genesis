        "    models=MODELS_6H,\n",
        "    lead=LEAD,\n",
        "    dataset_display=DATASET_DISPLAY,\n",
        "    dataset_slug=DATASET_SLUG,\n",
        "    mode=\"tuned\",\n",
        "    normalized=True,\n",
        ")\n",
        "\n",
        "display(cm_tuned_norm)"
