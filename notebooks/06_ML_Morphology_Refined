        "            Xz = z[feature_cols].copy()\n",
        "        else:\n",
        "            Xz = pd.DataFrame(z, columns=feature_cols)\n",
        "\n",
        "        return pipe.predict_proba(Xz)[:, 1]\n",
        "\n",
        "    return predict_positive\n",
        "\n",
        "# ------------------------------------------------------------\n",
