        "            ax.grid(True, axis=\"x\", alpha=0.3)\n",
        "\n",
        "            plt.tight_layout()\n",
        "\n",
        "            safe_model = model_name.replace(\" \", \"_\").replace(\"/\", \"_\")\n",
