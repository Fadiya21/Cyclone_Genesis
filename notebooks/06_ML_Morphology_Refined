        "            print(\"Saved:\", out_png)\n",
        "\n",
        "print(\"\\n[DONE] Feature ablation complete.\")\n",
        "print(\"Main table:\")\n",
        "print(ABLATION_DIR / \"feature_ablation_impact_vs_baseline.csv\")\n",
        "\n",
        "# ============================================================\n",
        "# FEATURE ABLATION HEATMAP\n",
        "# Rows   = predictors\n",
