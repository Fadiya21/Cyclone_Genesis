    "    linewidth=0.6\n",
    ")\n",
    "\n",
    "ax.set_xticks(x)\n",
    "ax.set_xticklabels([f\"{L} h\" for L in LEADS])\n",
    "ax.set_xlabel(\"Lead time\")\n",
    "ax.set_ylabel(\"Number of positive MCS snapshots\")\n",
    "ax.set_title(\n",
