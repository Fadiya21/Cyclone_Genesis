    "        ax.set_xlabel(\"Lead time\", fontsize=13)\n",
    "\n",
    "        if show_ylabel:\n",
    "            ax.set_ylabel(\"Predictor\", fontsize=13, labelpad=12)\n",
    "        else:\n",
    "            ax.set_ylabel(\"\")\n",
    "\n",
    "        ax.set_xticks(np.arange(mat.shape[1]))\n",
    "        ax.set_xticklabels(mat.columns, fontsize=12)\n",
    "\n",
    "        ax.set_yticks(np.arange(mat.shape[0]))\n",
