    "    return len(df)\n",
    "\n",
    "\n",
    "def setup_map_ax(ax):\n",
    "    if HAS_CARTOPY:\n",
    "        ax.set_extent(\n",
    "            [LON_MIN, LON_MAX, LAT_MIN, LAT_MAX],\n",
    "            crs=ccrs.PlateCarree()\n",
    "        )\n",
