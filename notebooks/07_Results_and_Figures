    "                  title_weight=\"bold\", z=2):\n",
    "    x, y = xy\n",
    "    box = FancyBboxPatch(\n",
    "        (x, y), w, h,\n",
    "        boxstyle=f\"round,pad=0.01,rounding_size={rounding}\",\n",
