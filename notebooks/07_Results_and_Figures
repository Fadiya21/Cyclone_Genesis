    "                vmax=vmax\n",
    "            )\n",
    "\n",
    "            ax.set_title(\n",
    "                f\"{DATASET_LABELS[ds]} AdaBoost\\nSHAP heatmap\",\n",
    "                color=DATASET_COLORS[ds],\n",
    "                fontsize=13\n",
    "            )\n",
    "\n",
    "            ax.set_xlabel(\"Lead time\")\n",
    "            ax.set_ylabel(\"Predictor\")\n",
    "\n",
    "            ax.set_xticks(np.arange(len(LEADS)))\n",
