    "\n",
    "        fig, axes = plt.subplots(1, 2, figsize=(13.5, 7.2), constrained_layout=True)\n",
    "\n",
    "        for ax, ds in zip(axes, [\"old\", \"new\"]):\n",
    "            sub = shap_df[shap_df[\"dataset\"] == ds].copy()\n",
    "\n",
    "            pivot = sub.pivot_table(\n",
    "                index=\"feature\",\n",
