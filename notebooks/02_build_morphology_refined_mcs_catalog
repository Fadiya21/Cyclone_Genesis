    "                ymdh_list.append(ymdh)\n",
    "        except Exception:\n",
    "            pass\n",
    "\n",
    "    day_counts = Counter([x[:8] for x in ymdh_list])\n",
    "\n",
    "    missing_days = []\n",
    "\n",
    "    for y in years:\n",
    "        for m in months:\n",
    "            ndays = calendar.monthrange(y, m)[1]\n",
