    "    print(\"Missing:\", len(missing))\n",
    "\n",
    "    if missing:\n",
    "        print(\"\\nMissing files:\")\n",
    "        for f in missing:\n",
    "            print(f)\n",
    "\n",
    "    qc_rows = []\n",
    "\n",
    "    for fp in expected:\n",
    "        if not fp.exists():\n",
    "            continue\n",
    "\n",
    "        df = pd.read_csv(fp, usecols=[\"time\", \"track_id\"])\n",
    "        df[\"time\"] = pd.to_datetime(df[\"time\"], errors=\"coerce\", utc=True).dt.tz_convert(None)\n",
